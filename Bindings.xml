<Bindings>
  <!-- WoWController Action Bar -->
  <Binding name="WOWACTIONB1" header="WOWACTIONBAR">ActionButton1:Click("LeftButton")</Binding>
  <Binding name="WOWACTIONB2" header="WOWACTIONBAR">ActionButton2:Click("LeftButton")</Binding>
  <Binding name="WOWACTIONB3" header="WOWACTIONBAR">ActionButton3:Click("LeftButton")</Binding>
  <Binding name="WOWACTIONB4" header="WOWACTIONBAR">ActionButton4:Click("LeftButton")</Binding>
  <Binding name="WOWACTIONB5" header="WOWACTIONBAR">ActionButton5:Click("LeftButton")</Binding>
  <Binding name="WOWACTIONB6" header="WOWACTIONBAR">ActionButton6:Click("LeftButton")</Binding>
  <Binding name="WOWACTIONB7" header="WOWACTIONBAR">ActionButton7:Click("LeftButton")</Binding>
  <Binding name="WOWACTIONB8" header="WOWACTIONBAR">ActionButton8:Click("LeftButton")</Binding>
  <Binding name="WOWACTIONB9" header="WOWACTIONBAR">ActionButton9:Click("LeftButton")</Binding>

  <!-- WoWController Custom Buttons -->

 
  <!-- UP: Inventory -->
  <Binding name="WOWCONTROL1" runOnUp="true">
    if ( keystate == "down" ) then
      ToggleCharacter("PaperDollFrame")
    end
  </Binding>
  
  <!-- RIGHT: QuestLog -->
  <Binding name="WOWCONTROL2" runOnUp="true">
    if ( keystate == "down" ) then
      ToggleQuestLog()
    end
  </Binding>
  
  <!-- DOWN: Talents & Social -->
  <Binding name="WOWCONTROL3" runOnUp="true">
    if ( keystate == "down" ) then
      ToggleTalentFrame()
      ToggleFriendsFrame()
    end
  </Binding>
  
  <!-- LEFT: Spellbook -->
  <Binding name="WOWCONTROL4" runOnUp="true">
    if ( keystate == "down" ) then
      ToggleSpellBook(BOOKTYPE_SPELL)
    end
  </Binding>
</Bindings>
